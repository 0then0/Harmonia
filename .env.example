# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
HARMONIA_API_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://harmonia:replace-with-postgres-password@localhost:5432/harmonia
REDIS_URL=redis://localhost:6379/0
# Provider tokens are optional. API and worker must share the same configuration.
SPOTIFY_ACCESS_TOKEN=
YANDEX_TOKEN=
# Docker: set to /run/providers/browser.json after mounting the file (see README).
YOUTUBE_AUTH_FILE=
MUSICBRAINZ_USER_AGENT=Harmonia/0.1.0 (https://github.com/0then0/Harmonia)
