# Required for Compose: generate a different value for each setting.
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
HARMONIA_API_KEY=
POSTGRES_PASSWORD=
# Host processes only: Compose supplies its own internal database and Redis URLs.
DATABASE_URL=postgresql+psycopg://harmonia:replace-with-postgres-password@localhost:5432/harmonia
REDIS_URL=redis://localhost:6379/0
# Optional providers; use the same configuration for API and worker.
# Setup and accepted references: docs/providers.md
SPOTIFY_ACCESS_TOKEN=
YANDEX_TOKEN=
# Docker: mount browser.json read-only, then set /run/providers/browser.json.
YOUTUBE_AUTH_FILE=
# Identify your deployment with its contact URL for MusicBrainz requests.
MUSICBRAINZ_USER_AGENT=Harmonia/0.1.0 (https://github.com/0then0/Harmonia)
